# 복사해서 server/.env 로 저장 후 값 변경
NODE_ENV=development
PORT=4000

# Firebase 프로젝트 ID (기본값: jongtak-lim)
FIREBASE_PROJECT_ID=jongtak-lim

# 로컬 개발: Firebase 서비스 계정 JSON 파일 경로
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# 프로덕션에서는 반드시 길고 무작위한 값으로 (예: openssl rand -hex 32)
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
HASH_SALT=change-me-too
CORS_ORIGIN=http://localhost:5173
GITHUB_USER=LimJongTak
# 선택: rate limit 완화용 GitHub 토큰 (public_repo 읽기 권한이면 충분)
GITHUB_TOKEN=
# 선택: 문의가 들어오면 알림 받을 Slack/Discord 웹훅
NOTIFY_WEBHOOK_URL=
