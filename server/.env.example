# 복사해서 server/.env 로 저장 후 값 변경
NODE_ENV=development
PORT=4000
DB_PATH=data/portfolio.db
# 프로덕션에서는 반드시 길고 무작위한 값으로 (예: openssl rand -hex 32)
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
HASH_SALT=change-me-too
CORS_ORIGIN=http://localhost:5173
GITHUB_USER=LimJongTak
# 선택: rate limit 완화용 GitHub 토큰 (public_repo 읽기 권한이면 충분)
GITHUB_TOKEN=
# 선택: 문의가 들어오면 알림 받을 Slack/Discord 웹훅
NOTIFY_WEBHOOK_URL=
